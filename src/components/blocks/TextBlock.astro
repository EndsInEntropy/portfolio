---
interface Props {
  eyebrow?: string;
  heading?: string;
  body: string[];
}

const { eyebrow, heading, body } = Astro.props;
---

<div class="block text-block grid-12">
  <div class="text-block__head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {heading && <h3 class="display text-block__heading">{heading}</h3>}
  </div>
  <div class="text-block__body prose">
    {body.map((para) => <p>{para}</p>)}
  </div>
</div>

<style>
  .text-block__head {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }

  .text-block__heading {
    font-size: var(--step-2);
    max-width: 12ch;
  }

  .text-block__body {
    grid-column: 5 / span 7;
    font-size: var(--step-0);
    color: var(--ink);
  }

  @media (max-width: 1080px) {
    .text-block__head,
    .text-block__body {
      grid-column: 1 / -1;
      position: static;
    }
    .text-block__body { margin-top: 1.5rem; }
  }
</style>
