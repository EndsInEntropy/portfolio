---
interface Props {
  heading?: string;
  items: { value: string; label: string }[];
}

const { heading, items } = Astro.props;
---

<div class="block stats-block wrap">
  {heading && <p class="eyebrow stats-block__eyebrow">{heading}</p>}
  <div class="stats-block__grid">
    {items.map((item) => (
      <div class="stats-block__item">
        <span class="display stats-block__value">{item.value}</span>
        <span class="text-soft stats-block__label">{item.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .stats-block__eyebrow { margin-bottom: 1.5rem; }

  .stats-block__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .stats-block__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stats-block__value {
    font-size: var(--step-3);
    line-height: 1;
  }

  .stats-block__label {
    font-size: var(--step--1);
  }
</style>
