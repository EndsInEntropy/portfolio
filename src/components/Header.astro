---
import site from '../data/site.json';
import { withBase } from '../lib/url';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const target = withBase(href);
  return currentPath === target || currentPath === target.replace(/\/$/, '');
}
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a href={withBase('/')} class="site-header__mark mono">
      {site.name.split(' ').map((w: string) => w[0]).join('')}
    </a>

    <nav class="site-header__nav">
      <ol class="site-header__list">
        {site.nav.map((item: { label: string; href: string }) => (
          <li>
            <a
              href={withBase(item.href)}
              class:list={['site-header__link', { 'is-active': isActive(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
  <div class="wrap"><hr class="rule" /></div>
</header>

<style>
  .site-header {
    padding-top: clamp(1rem, 0.8rem + 1vw, 1.75rem);
  }

  .site-header__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: clamp(1rem, 0.8rem + 1vw, 1.75rem);
  }

  .site-header__mark {
    font-size: var(--step-1);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .site-header__list {
    display: flex;
    gap: clamp(1.25rem, 0.8rem + 2vw, 2.75rem);
  }

  .site-header__link {
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--ink-soft);
    padding-bottom: 0.3em;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
