---
interface Props {
  label: string;
  figure?: string;
  ratio?: string; // css aspect-ratio value, e.g. "16/9"
  minimal?: boolean; // suppress the text label — for small thumbnails where it would overflow
}

const { label, figure, ratio = '16/10', minimal = false } = Astro.props;
---

<div class="ph" style={`aspect-ratio: ${ratio};`} role="img" aria-label={label}>
  {!minimal && (
    <div class="ph-label">
      {figure && <span class="mono ph-fig">{figure}</span>}
      <span class="mono ph-text">{label}</span>
    </div>
  )}
  {minimal && figure && (
    <span class="mono ph-fig ph-fig--corner" aria-hidden="true">{figure}</span>
  )}
</div>

<style>
  .ph {
    position: relative;
    width: 100%;
    background: var(--surface);
    overflow: hidden;
  }

  .ph-label {
    position: absolute;
    left: 1.25em;
    bottom: 1em;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    max-width: 70%;
  }

  .ph-fig {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .ph-text {
    font-size: var(--step--1);
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  .ph-fig--corner {
    position: absolute;
    bottom: 6px;
    right: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
</style>
