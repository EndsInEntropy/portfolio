---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnicalPlaceholder from '../components/TechnicalPlaceholder.astro';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const allCaseStudies = await getCollection('case-studies');
const featured = allCaseStudies
  .filter((c) => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${site.name} — ${site.title}`}>
  <section class="hero wrap">
    <div class="hero__grid grid-12">
      <p class="eyebrow hero__eyebrow">{site.title} / Portfolio</p>
      <h1 class="display hero__title">{site.name}</h1>
      <p class="prose text-soft hero__statement">{site.heroStatement}</p>
      <div class="hero__actions">
        <a class="btn btn--accent" href={withBase('/work/')}>View case studies</a>
        <a class="btn" href={withBase('/profile/')}>Profile</a>
      </div>
    </div>
  </section>

  <div class="wrap"><hr class="rule" /></div>

  <section class="index-list wrap">
    <div class="index-list__head">
      <p class="eyebrow">Selected work</p>
      <a class="link-arrow" href={withBase('/work/')}>All case studies →</a>
    </div>

    <ol class="index-list__rows">
      {featured.map((entry, i) => (
        <li>
          <a class="index-row" href={withBase(`/work/${entry.id}/`)}>
            <span class="mono index-row__num">{String(i + 1).padStart(2, '0')}</span>

            <span class="index-row__main">
              <span class="display index-row__title">{entry.data.title}</span>
              <span class="mono text-soft index-row__client">{entry.data.client} — {entry.data.year}</span>
            </span>

            <span class="index-row__tags mono text-faint">
              {entry.data.tags.slice(0, 3).join(' / ')}
            </span>

            <span class="index-row__thumb">
              {entry.data.coverImage.src
                ? <img src={entry.data.coverImage.src} alt={entry.data.coverImage.alt} loading="lazy" />
                : <TechnicalPlaceholder label={entry.data.coverImage.alt} ratio="4/3" minimal />}
            </span>

            <span class="mono index-row__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="wrap"><hr class="rule" /></div>

  <section class="statement wrap">
    <div class="statement__grid grid-12">
      <p class="eyebrow statement__eyebrow">Approach</p>
      <p class="display statement__text">
        Craft and organization aren't in tension — the job of a design leader is
        making sure they compound each other.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2rem, 1.5rem + 3vw, 5rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero__grid { row-gap: 1.25rem; }

  .hero__eyebrow { grid-column: 1 / -1; }

  .hero__title {
    grid-column: 1 / -1;
    font-size: var(--step-5);
    max-width: 16ch;
  }

  .hero__statement {
    grid-column: 1 / span 6;
    font-size: var(--step-1);
    margin-top: 1rem;
  }

  .hero__actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 1080px) {
    .hero__statement { grid-column: 1 / -1; }
  }

  .index-list {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .index-list__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .index-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto 88px 1.5rem;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-top: 1px solid var(--line);
    transition: background 0.2s ease;
  }

  .index-list__rows li:last-child .index-row {
    border-bottom: 1px solid var(--line);
  }

  .index-row:hover {
    background: var(--surface);
  }

  .index-row__num {
    color: var(--accent);
    font-size: var(--step-0);
  }

  .index-row__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .index-row__title {
    font-size: var(--step-2);
  }

  .index-row__client {
    font-size: var(--step--1);
  }

  .index-row__tags {
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .index-row__thumb {
    width: 88px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .index-row__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .index-row__arrow {
    justify-self: end;
    font-size: var(--step-1);
    color: var(--ink-faint);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .index-row:hover .index-row__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 720px) {
    .index-row {
      grid-template-columns: 1fr;
      grid-template-areas:
        'num'
        'main'
        'tags'
        'thumb';
      row-gap: 0.6rem;
    }
    .index-row__num { grid-area: num; }
    .index-row__main { grid-area: main; }
    .index-row__tags { grid-area: tags; white-space: normal; }
    .index-row__thumb { grid-area: thumb; width: 100%; }
    .index-row__arrow { display: none; }
  }

  .statement {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
  }

  .statement__eyebrow { grid-column: 1 / -1; margin-bottom: 1.5rem; }

  .statement__text {
    grid-column: 2 / span 9;
    font-size: var(--step-3);
    line-height: 1.08;
  }

  @media (max-width: 1080px) {
    .statement__text { grid-column: 1 / -1; }
  }
</style>
